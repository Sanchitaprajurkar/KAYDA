# Nine Realms Backend Environment Configuration
PROJECT_NAME="Trial of the Nine Realms"
VERSION="1.0.0"
API_V1_PREFIX="/api"

# Default As-Of Simulation Date (Enforces simulated clock)
DEFAULT_AS_OF_DATE="2027-01-25"

# Optional LLM integration (fallback is 100% deterministic grounded offline reasoning engine)
OPENAI_API_KEY=""
GROQ_API_KEY=""

# Database Configuration (Neon PostgreSQL)
DATABASE_URL="postgresql://user:password@endpoint.region.aws.neon.tech/neondb?sslmode=require"

# Server Ports
HOST="0.0.0.0"
PORT=8000
